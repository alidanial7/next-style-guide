# Local / development — copy to `.env`
#   cp .env.example .env
#
# Other templates: `.env.staging.example`, `.env.production.example`

# Public app URL (browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API origin (server + client)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional server-only API origin (if you proxy and keep secrets off the client)
# API_URL=http://localhost:8000

# Auth.js (only when auth=authjs was enabled at scaffold)
# AUTH_SECRET=

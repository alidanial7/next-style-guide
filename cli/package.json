{
  "name": "create-next-style-guide",
  "version": "0.1.0",
  "description": "Scaffold a Next.js app with next-style-guide conventions (T3-style CLI)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-next-style-guide": "./dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "addons"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

{
  "name": "create-next-style-guide",
  "version": "0.1.16",
  "description": "Scaffold a Next.js app with next-style-guide conventions",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-next-style-guide": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alidanial7/next-style-guide.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/alidanial7/next-style-guide#readme",
  "bugs": {
    "url": "https://github.com/alidanial7/next-style-guide/issues"
  },
  "files": [
    "dist",
    "template",
    "addons",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "sync-npm-meta": "node ./scripts/sync-npm-meta.mjs",
    "prepack": "node ./scripts/sync-npm-meta.mjs",
    "prepublishOnly": "pnpm build && node ./scripts/sync-npm-meta.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
